rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /kadro_tasks/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reports/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && request.auth.token.email == 'ufuk.kop33@gmail.com';
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['kadroPoints']);
      allow delete: if false;
    }

    // Muhtarlık koordinatları — yalnızca sunucu yazar; istemci okuyamaz (doğrulama Cloud Function'da).
    match /izmir_muhtarliklar/{id} {
      allow read: if false;
      allow write: if false;
    }

    // Kp check-in kayıtları — üye kendi kaydını okuyabilir; yazma yalnızca sunucu.
    match /kp_checkins/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
